# Example only. Keep real values in the hosting environment, never in Git.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@postgresql-elrincondidactico.alwaysdata.net:5432/elrincondidactico_tienda
STORAGE_DIR=/home/elrincondidactico/private-store-storage
COOKIE_SECURE=1
# Set these to the actual hostname and HTTPS URL configured in Alwaysdata.
TRUSTED_HOSTS=your-actual-hostname
SITE_URL=https://your-actual-hostname
CONTACT_EMAIL=
# Optional manual transfer. Empty disables manual orders.
PAYMENT_INSTRUCTIONS=
# All four settings are required before enabling Mercado Pago.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
# Start with test accounts. Switch to 1 only after a successful end-to-end test.
MP_LIVE_MODE=0
# Transactional email worker; schedule flask --app wsgi send-mail.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=1
